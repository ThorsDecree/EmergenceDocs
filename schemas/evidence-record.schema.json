{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emergencedocs:schema:evidence-record:v0.1",
  "title": "EmergenceDocs EvidenceRecord v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "evidence_id", "evidence_type", "claim_refs", "observation_refs", "provenance_refs", "summary", "eligibility"],
  "properties": {
    "record_type": {"const": "evidence"},
    "schema_version": {"const": "0.1"},
    "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"},
    "evidence_type": {"type": "string", "enum": ["raw", "derived", "aggregate", "control-comparison", "null-result", "negative-result"]},
    "claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^ED-[A-Z0-9]+-[0-9]{3}$"}, "minItems": 1, "uniqueItems": true},
    "observation_refs": {"type": "array", "items": {"type": "string", "pattern": "^OBS-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
    "provenance_refs": {"type": "array", "items": {"type": "string", "pattern": "^PROV-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
    "transformation_refs": {"type": "array", "items": {"type": "string", "pattern": "^PROV-[A-Z0-9-]+$"}, "uniqueItems": true, "default": []},
    "summary": {"type": "string", "minLength": 1},
    "artifact_ref": {"type": ["string", "null"]},
    "measurement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {},
        "unit": {"type": ["string", "null"]},
        "uncertainty": {"type": ["number", "string", "null"]},
        "baseline": {},
        "analysis_ref": {"type": ["string", "null"]}
      }
    },
    "integrity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"type": "string", "enum": ["git-blob-sha1", "sha256", "sha512", "other"]},
        "digest": {"type": "string", "minLength": 1}
      }
    },
    "eligibility": {"type": "string", "enum": ["eligible", "blocked-pending-review", "excluded-by-method", "invalidated"]},
    "created_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  }
}
