{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emergencedocs:schema:method-record:v0.1",
  "title": "EmergenceDocs MethodRecord v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "method_id", "title", "version", "status", "claim_refs", "protocol_ref", "conditions", "controls", "metrics", "exclusion_rules", "analysis_plan", "stopping_rule", "blinding", "disconfirming_outcomes", "independence_requirement"],
  "properties": {
    "record_type": {"const": "method"},
    "schema_version": {"const": "0.1"},
    "method_id": {"type": "string", "pattern": "^MTH-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["method-proposal", "preregistered", "executed", "invalidated", "superseded"]},
    "claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^ED-[A-Z0-9]+-[0-9]{3}$"}, "minItems": 1, "uniqueItems": true},
    "protocol_ref": {"type": "string", "minLength": 1},
    "test_families": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "controls": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "sampling_plan": {"type": "string"},
    "holdout_plan": {"type": "string"},
    "metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "exclusion_rules": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "analysis_plan": {"type": "string", "minLength": 1},
    "stopping_rule": {"type": "string", "minLength": 1},
    "blinding": {"type": "string", "minLength": 1},
    "disconfirming_outcomes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "independence_requirement": {"type": "string", "enum": ["I0-originator", "I1-separated-role", "I2-independent-reviewer", "I3-external-replication"]},
    "material_constraints": {"type": "array", "items": {"type": "string"}, "default": []},
    "deviations": {"type": "array", "items": {"type": "string"}, "default": []},
    "created_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  }
}
