{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emergencedocs:schema:evaluation-record:v0.1",
  "title": "EmergenceDocs EvaluationRecord v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "evaluation_id", "claim_ref", "method_ref", "evidence_refs", "evaluator_ref", "independence_level", "outcome", "scope", "criteria_results", "reasoning_summary"],
  "properties": {
    "record_type": {"const": "evaluation"},
    "schema_version": {"const": "0.1"},
    "evaluation_id": {"type": "string", "pattern": "^EVAL-[A-Z0-9-]+$"},
    "claim_ref": {"type": "string", "pattern": "^ED-[A-Z0-9]+-[0-9]{3}$"},
    "method_ref": {"type": "string", "pattern": "^MTH-[A-Z0-9-]+$"},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
    "provenance_refs": {"type": "array", "items": {"type": "string", "pattern": "^PROV-[A-Z0-9-]+$"}, "uniqueItems": true, "default": []},
    "evaluator_ref": {"type": "string", "minLength": 1},
    "independence_level": {"type": "string", "enum": ["I0-originator", "I1-separated-role", "I2-independent-reviewer", "I3-external-replication"]},
    "outcome": {"type": "string", "enum": ["supported", "inconclusive", "refuted", "invalid-test", "needs-replication"]},
    "scope": {"type": "string", "minLength": 1},
    "criteria_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "result"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "result": {"type": "string", "enum": ["pass", "fail", "ambiguous", "not-applicable"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "default": []},
          "notes": {"type": "string"}
        }
      }
    },
    "reasoning_summary": {"type": "string", "minLength": 1},
    "method_deviations": {"type": "array", "items": {"type": "string"}, "default": []},
    "conflicts_of_interest": {"type": "array", "items": {"type": "string"}, "default": []},
    "created_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  }
}
