{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emergencedocs:schema:pilot-preregistration:v0.1",
  "title": "EmergenceDocs PilotPreregistration v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "pilot_id", "title", "status", "primary_claim_refs", "secondary_claim_refs", "method_ref", "protocol_ref", "materials_policy", "conditions", "holdout_boundary", "primary_endpoints", "outcome_rules", "evaluator_boundary", "freeze_rule"],
  "properties": {
    "record_type": {"const": "pilot-preregistration"},
    "schema_version": {"const": "0.1"},
    "pilot_id": {"type": "string", "pattern": "^PILOT-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["draft", "preregistered-not-run", "running", "completed", "invalidated", "superseded"]},
    "primary_claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^ED-[A-Z0-9]+-[0-9]{3}$"}, "minItems": 1, "uniqueItems": true},
    "secondary_claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^ED-[A-Z0-9]+-[0-9]{3}$"}, "uniqueItems": true},
    "method_ref": {"type": "string", "pattern": "^MTH-[A-Z0-9-]+$"},
    "protocol_ref": {"type": "string", "minLength": 1},
    "materials_policy": {"type": "string", "minLength": 1},
    "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "holdout_boundary": {"type": "string", "minLength": 1},
    "primary_endpoints": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "secondary_endpoints": {"type": "array", "items": {"type": "string"}, "default": []},
    "outcome_rules": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "evaluator_boundary": {"type": "string", "minLength": 1},
    "freeze_rule": {"type": "string", "minLength": 1},
    "preregistered_at": {"type": ["string", "null"], "format": "date-time"},
    "frozen_commit_ref": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
